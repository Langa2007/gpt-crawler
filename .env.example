# Go Gateway Settings
GO_SERVER_PORT=8080
PYTHON_AI_URL=http://127.0.0.1:5000

# Python AI Settings
PYTHON_AI_HOST=127.0.0.1
PYTHON_AI_PORT=5000

# ==============================================================================
# AI Synthesis & Intelligence Providers
# The scraper supports multiple AI backends for synthesis and chat.
# Active provider: gemini | openai | claude | kimi | qwen | custom
# If left blank, it automatically uses the first configured key found below.
# If no keys are provided, it safely falls back to built-in heuristic extraction.
# ==============================================================================
AI_PROVIDER=
DEFAULT_AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SEC=35.0

# 1. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI / ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# 3. Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 4. Moonshot Kimi
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_API_BASE=https://api.moonshot.cn/v1

# 5. Alibaba Qwen (DashScope)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 6. Custom / Local AI (Ollama, DeepSeek, Groq, vLLM, LM Studio)
# Example for local Ollama: http://localhost:11434/v1
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Search providers: comma-separated duckduckgo, searxng, brave.
SEARCH_PROVIDERS=duckduckgo
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
SEARCH_TIMEOUT_SEC=12

# Data collection & Crypto
PROVIDER_RETRIES=3
DATA_FRESHNESS_SEC=300
DATA_STORE_PATH=data/collections.sqlite3
COINGECKO_API_KEY=

# Optional client authentication. Format: key:scope1|scope2,key2
RESEARCH_API_KEYS=
